# Ubuntu 24.04 测试环境
FROM ubuntu:24.04

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive

# 更新apt并安装必要的基础工具
RUN apt update && apt install -y \
    curl \
    wget \
    lsb-release \
    && rm -rf /var/lib/apt/lists/*

# 复制初始化脚本
COPY init_develop.sh /root/init_develop.sh

# 给脚本添加执行权限
RUN chmod +x /root/init_develop.sh

# 设置工作目录
WORKDIR /root

# 启动命令
CMD ["/bin/bash"]
